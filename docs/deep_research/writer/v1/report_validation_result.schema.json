{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "Reference from a claim to existing evidence; semantic validity is later work.",
      "properties": {
        "citation_id": {
          "description": "Program-generated deterministic citation ID.",
          "title": "Citation Id",
          "type": "string"
        },
        "claim_id": {
          "description": "Referenced claim ID.",
          "title": "Claim Id",
          "type": "string"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "evidence_id": {
          "description": "Referenced evidence ID.",
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional verbatim quote from the evidence content.",
          "title": "Quote"
        },
        "quote_span_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exclusive quote span end.",
          "title": "Quote Span End"
        },
        "quote_span_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional inclusive quote span start.",
          "title": "Quote Span Start"
        },
        "relation": {
          "$ref": "#/$defs/CitationRelation",
          "description": "Declared evidence relation."
        }
      },
      "required": [
        "citation_id",
        "claim_id",
        "evidence_id",
        "relation"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitationRelation": {
      "enum": [
        "support",
        "contradict",
        "context"
      ],
      "title": "CitationRelation",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "Task-local assertion without embedded citation objects or validation status.",
      "properties": {
        "claim_id": {
          "description": "Program-generated deterministic claim ID.",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional claim category.",
          "title": "Claim Type"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "entities": {
          "default": [],
          "description": "Optional referenced entity labels.",
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "language": {
          "description": "Claim language tag.",
          "title": "Language",
          "type": "string"
        },
        "task_id": {
          "description": "Owning task ID.",
          "title": "Task Id",
          "type": "string"
        },
        "text": {
          "description": "Claim text.",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "task_id",
        "text",
        "language"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ReportStatus": {
      "enum": [
        "complete",
        "partial",
        "insufficient_evidence",
        "manual_review_required"
      ],
      "title": "ReportStatus",
      "type": "string"
    },
    "ReportValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "claim_text_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Text Sha256"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "section_heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Heading"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "code",
        "severity"
      ],
      "title": "ReportValidationIssue",
      "type": "object"
    },
    "ValidatedReport": {
      "additionalProperties": false,
      "properties": {
        "author_review_required": {
          "const": true,
          "default": true,
          "title": "Author Review Required",
          "type": "boolean"
        },
        "brief_id": {
          "title": "Brief Id",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "disclosed_conflict_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Disclosed Conflict Ids",
          "type": "array"
        },
        "evidence_graph_sha256": {
          "title": "Evidence Graph Sha256",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "publication_ready": {
          "const": false,
          "default": false,
          "title": "Publication Ready",
          "type": "boolean"
        },
        "report_id": {
          "title": "Report Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "dr-validated-report-v1",
          "default": "dr-validated-report-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/ValidatedReportSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "unresolved_conflict_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved Conflict Ids",
          "type": "array"
        },
        "unresolved_gap_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved Gap Ids",
          "type": "array"
        }
      },
      "required": [
        "report_id",
        "task_id",
        "brief_id",
        "plan_id",
        "run_id",
        "evidence_graph_sha256",
        "status",
        "sections",
        "claims",
        "citations"
      ],
      "title": "ValidatedReport",
      "type": "object"
    },
    "ValidatedReportSection": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "heading": {
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "section_id": {
          "title": "Section Id",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "heading",
        "claim_ids"
      ],
      "title": "ValidatedReportSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "dr-contracts-v1",
      "default": "dr-contracts-v1",
      "description": "Stable DeepResearch contract version.",
      "title": "Contract Version",
      "type": "string"
    },
    "deterministic_grounding_verified": {
      "default": false,
      "title": "Deterministic Grounding Verified",
      "type": "boolean"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidatedReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "dr-validated-report-v1",
      "default": "dr-validated-report-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_correctness_verified": {
      "const": false,
      "default": false,
      "title": "Semantic Correctness Verified",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/ReportStatus"
    }
  },
  "required": [
    "status"
  ],
  "title": "ReportValidationResult",
  "type": "object"
}
