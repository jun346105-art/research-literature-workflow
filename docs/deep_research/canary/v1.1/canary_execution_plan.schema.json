{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict fixed-policy input for the single ordinary-API Canary path.",
  "properties": {
    "adapter_commit_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Commit Sha"
    },
    "approval_state": {
      "const": "user_authorized_single_call",
      "title": "Approval State",
      "type": "string"
    },
    "channel": {
      "const": "ordinary_model_api",
      "title": "Channel",
      "type": "string"
    },
    "credential_environment_variable": {
      "const": "ZHIPUAI_API_KEY",
      "title": "Credential Environment Variable",
      "type": "string"
    },
    "endpoint": {
      "const": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "title": "Endpoint",
      "type": "string"
    },
    "fallback_enabled": {
      "const": false,
      "title": "Fallback Enabled",
      "type": "boolean"
    },
    "files_enabled": {
      "const": false,
      "title": "Files Enabled",
      "type": "boolean"
    },
    "input_price_per_million_tokens": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Input Price Per Million Tokens"
    },
    "max_input_tokens": {
      "const": 512,
      "title": "Max Input Tokens",
      "type": "integer"
    },
    "max_output_tokens": {
      "const": 256,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "max_provider_calls": {
      "const": 1,
      "title": "Max Provider Calls",
      "type": "integer"
    },
    "max_retries": {
      "const": 0,
      "title": "Max Retries",
      "type": "integer"
    },
    "model_id": {
      "const": "glm-5.3-flash",
      "title": "Model Id",
      "type": "string"
    },
    "monetary_budget_currency": {
      "const": "CNY",
      "title": "Monetary Budget Currency",
      "type": "string"
    },
    "monetary_budget_limit": {
      "anyOf": [
        {
          "maximum": 0.01,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Monetary Budget Limit"
    },
    "operation_timeout_seconds": {
      "const": 30,
      "title": "Operation Timeout Seconds",
      "type": "integer"
    },
    "output_price_per_million_tokens": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Output Price Per Million Tokens"
    },
    "parallel_enabled": {
      "const": false,
      "title": "Parallel Enabled",
      "type": "boolean"
    },
    "pricing_type": {
      "const": "promotional",
      "title": "Pricing Type",
      "type": "string"
    },
    "provider": {
      "const": "zhipu-bigmodel",
      "title": "Provider",
      "type": "string"
    },
    "run_deadline_seconds": {
      "const": 45,
      "title": "Run Deadline Seconds",
      "type": "integer"
    },
    "schema_version": {
      "const": "dr-canary-execution-plan-v1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "text_only": {
      "const": true,
      "title": "Text Only",
      "type": "boolean"
    },
    "tools_enabled": {
      "const": false,
      "title": "Tools Enabled",
      "type": "boolean"
    },
    "video_enabled": {
      "const": false,
      "title": "Video Enabled",
      "type": "boolean"
    },
    "vision_enabled": {
      "const": false,
      "title": "Vision Enabled",
      "type": "boolean"
    },
    "web_enabled": {
      "const": false,
      "title": "Web Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "provider",
    "model_id",
    "endpoint",
    "channel",
    "text_only",
    "tools_enabled",
    "vision_enabled",
    "video_enabled",
    "files_enabled",
    "web_enabled",
    "parallel_enabled",
    "fallback_enabled",
    "max_provider_calls",
    "max_retries",
    "max_input_tokens",
    "max_output_tokens",
    "operation_timeout_seconds",
    "run_deadline_seconds",
    "monetary_budget_currency",
    "monetary_budget_limit",
    "pricing_type",
    "input_price_per_million_tokens",
    "output_price_per_million_tokens",
    "approval_state",
    "credential_environment_variable"
  ],
  "title": "GLMCanaryPlan",
  "type": "object"
}
