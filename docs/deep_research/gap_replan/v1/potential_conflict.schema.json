{
  "$defs": {
    "ConflictType": {
      "enum": [
        "semantic_inconsistency",
        "structured_value_conflict",
        "provenance_identity_conflict"
      ],
      "title": "ConflictType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conflict_id": {
      "title": "Conflict Id",
      "type": "string"
    },
    "conflict_type": {
      "$ref": "#/$defs/ConflictType"
    },
    "contract_version": {
      "const": "dr-contracts-v1",
      "default": "dr-contracts-v1",
      "description": "Stable DeepResearch contract version.",
      "title": "Contract Version",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dr-gap-replan-v1",
      "default": "dr-gap-replan-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "unresolved",
      "default": "unresolved",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "conflict_id",
    "run_id",
    "conflict_type",
    "evidence_ids"
  ],
  "title": "PotentialConflict",
  "type": "object"
}
