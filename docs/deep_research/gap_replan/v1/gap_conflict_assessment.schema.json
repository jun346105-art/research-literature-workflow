{
  "$defs": {
    "ConflictType": {
      "enum": [
        "semantic_inconsistency",
        "structured_value_conflict",
        "provenance_identity_conflict"
      ],
      "title": "ConflictType",
      "type": "string"
    },
    "EvidenceGap": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "gap_id": {
          "title": "Gap Id",
          "type": "string"
        },
        "gap_type": {
          "$ref": "#/$defs/GapType"
        },
        "observed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Observed",
          "type": "array"
        },
        "required": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "dr-gap-replan-v1",
          "default": "dr-gap-replan-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subtask_id": {
          "title": "Subtask Id",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "run_id",
        "subtask_id",
        "gap_type"
      ],
      "title": "EvidenceGap",
      "type": "object"
    },
    "GapType": {
      "enum": [
        "subtask_no_evidence",
        "evidence_count_below_required",
        "required_evidence_type_missing",
        "source_diversity_insufficient",
        "dependency_unsatisfied",
        "scope_not_covered"
      ],
      "title": "GapType",
      "type": "string"
    },
    "PotentialConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "title": "Conflict Id",
          "type": "string"
        },
        "conflict_type": {
          "$ref": "#/$defs/ConflictType"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "dr-gap-replan-v1",
          "default": "dr-gap-replan-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "unresolved",
          "default": "unresolved",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "run_id",
        "conflict_type",
        "evidence_ids"
      ],
      "title": "PotentialConflict",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "conflicts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PotentialConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "contract_version": {
      "const": "dr-contracts-v1",
      "default": "dr-contracts-v1",
      "description": "Stable DeepResearch contract version.",
      "title": "Contract Version",
      "type": "string"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dr-gap-replan-v1",
      "default": "dr-gap-replan-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "run_id"
  ],
  "title": "GapConflictAssessment",
  "type": "object"
}
