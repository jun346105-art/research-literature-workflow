{
  "$defs": {
    "ResearchSubtask": {
      "additionalProperties": false,
      "description": "Task-local research question with declarative DAG dependencies only.",
      "properties": {
        "completion_criteria": {
          "default": [],
          "description": "Observable subtask completion criteria.",
          "items": {
            "type": "string"
          },
          "title": "Completion Criteria",
          "type": "array"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "dependency_ids": {
          "default": [],
          "description": "Required predecessor subtask IDs.",
          "items": {
            "type": "string"
          },
          "title": "Dependency Ids",
          "type": "array"
        },
        "expected_evidence": {
          "default": [],
          "description": "Expected evidence categories.",
          "items": {
            "type": "string"
          },
          "title": "Expected Evidence",
          "type": "array"
        },
        "question": {
          "description": "Subtask research question.",
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "rationale": {
          "description": "Why the subtask is needed.",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "subtask_id": {
          "description": "Program-generated deterministic subtask ID.",
          "title": "Subtask Id",
          "type": "string"
        },
        "task_id": {
          "description": "Owning task ID.",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "subtask_id",
        "task_id",
        "question",
        "rationale"
      ],
      "title": "ResearchSubtask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "title": "Approval Id",
      "type": "string"
    },
    "brief_id": {
      "title": "Brief Id",
      "type": "string"
    },
    "contract_version": {
      "const": "dr-contracts-v1",
      "default": "dr-contracts-v1",
      "description": "Stable DeepResearch contract version.",
      "title": "Contract Version",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "parent_plan_id": {
      "title": "Parent Plan Id",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dr-replanned-research-plan-v1",
      "default": "dr-replanned-research-plan-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subtasks": {
      "items": {
        "$ref": "#/$defs/ResearchSubtask"
      },
      "title": "Subtasks",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "topological_subtask_ids": {
      "items": {
        "type": "string"
      },
      "title": "Topological Subtask Ids",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "parent_plan_id",
    "decision_id",
    "task_id",
    "brief_id",
    "approval_id",
    "subtasks",
    "topological_subtask_ids"
  ],
  "title": "ReplannedResearchPlan",
  "type": "object"
}
