{
  "$defs": {
    "ReplanOutcome": {
      "enum": [
        "no_replan_needed",
        "replan_allowed",
        "insufficient_evidence",
        "budget_exhausted",
        "deadline_exceeded",
        "manual_intervention_required",
        "cancelled"
      ],
      "title": "ReplanOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "conflict_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Conflict Ids",
      "type": "array"
    },
    "contract_version": {
      "const": "dr-contracts-v1",
      "default": "dr-contracts-v1",
      "description": "Stable DeepResearch contract version.",
      "title": "Contract Version",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "gap_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Gap Ids",
      "type": "array"
    },
    "original_plan_id": {
      "title": "Original Plan Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/ReplanOutcome"
    },
    "replan_ordinal": {
      "default": 0,
      "minimum": 0,
      "title": "Replan Ordinal",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dr-gap-replan-v1",
      "default": "dr-gap-replan-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "run_id",
    "assessment_id",
    "original_plan_id",
    "outcome"
  ],
  "title": "ReplanDecisionRecord",
  "type": "object"
}
