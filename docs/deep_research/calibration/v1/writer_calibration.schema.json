{
  "$defs": {
    "GLMInvocationPolicy": {
      "additionalProperties": false,
      "description": "Shared, ordinary-model, text-only provider contract for Planner and Writer.",
      "properties": {
        "credential_environment_variable": {
          "const": "ZHIPUAI_API_KEY",
          "default": "ZHIPUAI_API_KEY",
          "title": "Credential Environment Variable",
          "type": "string"
        },
        "endpoint": {
          "const": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
          "default": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
          "title": "Endpoint",
          "type": "string"
        },
        "fallback_enabled": {
          "const": false,
          "default": false,
          "title": "Fallback Enabled",
          "type": "boolean"
        },
        "files_enabled": {
          "const": false,
          "default": false,
          "title": "Files Enabled",
          "type": "boolean"
        },
        "input_price_per_million_micros": {
          "const": 400000,
          "default": 400000,
          "title": "Input Price Per Million Micros",
          "type": "integer"
        },
        "max_input_tokens": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 512,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_retries": {
          "const": 0,
          "default": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "model_id": {
          "const": "glm-5.3-flash",
          "default": "glm-5.3-flash",
          "title": "Model Id",
          "type": "string"
        },
        "monetary_budget_limit_micros": {
          "default": 10000,
          "maximum": 20000,
          "minimum": 10000,
          "title": "Monetary Budget Limit Micros",
          "type": "integer"
        },
        "operation_timeout_seconds": {
          "default": 60,
          "maximum": 60,
          "minimum": 30,
          "title": "Operation Timeout Seconds",
          "type": "integer"
        },
        "output_price_per_million_micros": {
          "const": 1400000,
          "default": 1400000,
          "title": "Output Price Per Million Micros",
          "type": "integer"
        },
        "parallel_enabled": {
          "const": false,
          "default": false,
          "title": "Parallel Enabled",
          "type": "boolean"
        },
        "planner_max_input_tokens": {
          "const": 2048,
          "default": 2048,
          "title": "Planner Max Input Tokens",
          "type": "integer"
        },
        "planner_max_output_tokens": {
          "const": 4096,
          "default": 4096,
          "title": "Planner Max Output Tokens",
          "type": "integer"
        },
        "planner_reasoning_effort": {
          "default": "low",
          "enum": [
            "low",
            "high",
            "max"
          ],
          "title": "Planner Reasoning Effort",
          "type": "string"
        },
        "reasoning_effort": {
          "default": "max",
          "enum": [
            "low",
            "high",
            "max"
          ],
          "title": "Reasoning Effort",
          "type": "string"
        },
        "run_timeout_seconds": {
          "default": 180,
          "maximum": 180,
          "minimum": 90,
          "title": "Run Timeout Seconds",
          "type": "integer"
        },
        "temperature": {
          "const": 1,
          "default": 1,
          "title": "Temperature",
          "type": "integer"
        },
        "thinking_type": {
          "const": "enabled",
          "default": "enabled",
          "title": "Thinking Type",
          "type": "string"
        },
        "tools_enabled": {
          "const": false,
          "default": false,
          "title": "Tools Enabled",
          "type": "boolean"
        },
        "top_p": {
          "const": 0.95,
          "default": 0.95,
          "title": "Top P",
          "type": "number"
        },
        "video_enabled": {
          "const": false,
          "default": false,
          "title": "Video Enabled",
          "type": "boolean"
        },
        "vision_enabled": {
          "const": false,
          "default": false,
          "title": "Vision Enabled",
          "type": "boolean"
        },
        "web_enabled": {
          "const": false,
          "default": false,
          "title": "Web Enabled",
          "type": "boolean"
        },
        "writer_max_input_tokens": {
          "const": 4096,
          "default": 4096,
          "title": "Writer Max Input Tokens",
          "type": "integer"
        },
        "writer_max_output_tokens": {
          "const": 4096,
          "default": 4096,
          "title": "Writer Max Output Tokens",
          "type": "integer"
        },
        "writer_reasoning_effort": {
          "default": "high",
          "enum": [
            "low",
            "high",
            "max"
          ],
          "title": "Writer Reasoning Effort",
          "type": "string"
        }
      },
      "title": "GLMInvocationPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_dir": {
      "pattern": "^outputs/deep_research/writer_calibration/v1/dr-calibration-[0-9a-f]{24}$",
      "title": "Artifact Dir",
      "type": "string"
    },
    "calibration_id": {
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "title": "Calibration Id",
      "type": "string"
    },
    "fixture_id": {
      "const": "single_paper_evidence_graph_v1",
      "default": "single_paper_evidence_graph_v1",
      "title": "Fixture Id",
      "type": "string"
    },
    "implementation_commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Implementation Commit Sha",
      "type": "string"
    },
    "max_provider_calls": {
      "const": 1,
      "default": 1,
      "title": "Max Provider Calls",
      "type": "integer"
    },
    "max_retries": {
      "const": 0,
      "default": 0,
      "title": "Max Retries",
      "type": "integer"
    },
    "policy": {
      "$ref": "#/$defs/GLMInvocationPolicy",
      "default": {
        "credential_environment_variable": "ZHIPUAI_API_KEY",
        "endpoint": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
        "fallback_enabled": false,
        "files_enabled": false,
        "input_price_per_million_micros": 400000,
        "max_input_tokens": 1024,
        "max_output_tokens": 1024,
        "max_retries": 0,
        "model_id": "glm-5.3-flash",
        "monetary_budget_limit_micros": 10000,
        "operation_timeout_seconds": 60,
        "output_price_per_million_micros": 1400000,
        "parallel_enabled": false,
        "planner_max_input_tokens": 2048,
        "planner_max_output_tokens": 4096,
        "planner_reasoning_effort": "low",
        "reasoning_effort": "max",
        "run_timeout_seconds": 180,
        "temperature": 1,
        "thinking_type": "enabled",
        "tools_enabled": false,
        "top_p": 0.95,
        "video_enabled": false,
        "vision_enabled": false,
        "web_enabled": false,
        "writer_max_input_tokens": 4096,
        "writer_max_output_tokens": 4096,
        "writer_reasoning_effort": "high"
      }
    },
    "runtime_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Source Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "dr-writer-calibration-v1",
      "default": "dr-writer-calibration-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "calibration_id",
    "implementation_commit_sha",
    "runtime_source_sha256",
    "artifact_dir"
  ],
  "title": "WriterCalibrationPlan",
  "type": "object"
}
