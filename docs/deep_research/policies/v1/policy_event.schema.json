{
  "$defs": {
    "PolicyEventType": {
      "enum": [
        "operation_planned",
        "operation_started",
        "operation_succeeded",
        "operation_failed",
        "operation_unknown",
        "operation_cancelled",
        "attempt_charged",
        "replan_decided",
        "elapsed_recorded"
      ],
      "title": "PolicyEventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Strict policy fact event; lifecycle RunEvent remains unchanged.",
  "properties": {
    "admitted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Admitted"
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "attempt_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Number"
    },
    "contract_version": {
      "const": "dr-contracts-v1",
      "default": "dr-contracts-v1",
      "description": "Stable DeepResearch contract version.",
      "title": "Contract Version",
      "type": "string"
    },
    "cost_micros": {
      "default": "0",
      "title": "Cost Micros",
      "type": "string"
    },
    "elapsed_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed S"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "event_hash": {
      "title": "Event Hash",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/PolicyEventType"
    },
    "idempotent": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotent"
    },
    "input_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "old_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Old Plan Id"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "operation_kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Kind"
    },
    "operation_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Name"
    },
    "operation_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Status"
    },
    "output_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "policy_version": {
      "default": "dr-policies-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "previous_event_hash": {
      "title": "Previous Event Hash",
      "type": "string"
    },
    "proposed_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Plan Id"
    },
    "rejected_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejected Reason"
    },
    "replan_ordinal": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replan Ordinal"
    },
    "result_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Sha256"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "side_effecting": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Side Effecting"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "event_type",
    "previous_event_hash",
    "event_hash"
  ],
  "title": "PolicyEvent",
  "type": "object"
}
