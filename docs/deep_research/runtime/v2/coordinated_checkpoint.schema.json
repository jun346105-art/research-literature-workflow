{
  "$defs": {
    "BudgetCharge": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_number": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "operation_id",
        "attempt_id",
        "kind",
        "outcome",
        "usage"
      ],
      "title": "BudgetCharge",
      "type": "object"
    },
    "BudgetLedger": {
      "additionalProperties": false,
      "properties": {
        "charges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BudgetCharge"
          },
          "title": "Charges",
          "type": "array"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "cost_micros": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cost Micros"
        },
        "elapsed_s": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed S",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "policy_version": {
          "default": "dr-policies-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "provider_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Attempts",
          "type": "integer"
        },
        "provider_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Calls",
          "type": "integer"
        },
        "provider_succeeded": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Succeeded",
          "type": "integer"
        },
        "replans": {
          "default": 0,
          "minimum": 0,
          "title": "Replans",
          "type": "integer"
        },
        "reservations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BudgetReservation"
          },
          "title": "Reservations",
          "type": "array"
        },
        "retries": {
          "default": 0,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "tool_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Attempts",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "tool_succeeded": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Succeeded",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "BudgetLedger",
      "type": "object"
    },
    "BudgetReservation": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        }
      },
      "required": [
        "operation_id",
        "attempt_id",
        "kind",
        "usage"
      ],
      "title": "BudgetReservation",
      "type": "object"
    },
    "OperationJournal": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OperationRecord"
          },
          "title": "Records",
          "type": "array"
        }
      },
      "title": "OperationJournal",
      "type": "object"
    },
    "OperationKind": {
      "enum": [
        "provider",
        "tool"
      ],
      "title": "OperationKind",
      "type": "string"
    },
    "OperationRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_number": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "idempotent": {
          "title": "Idempotent",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/OperationKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "result_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Sha256"
        },
        "side_effecting": {
          "title": "Side Effecting",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/OperationStatus",
          "default": "planned"
        }
      },
      "required": [
        "operation_id",
        "attempt_id",
        "kind",
        "name",
        "idempotent",
        "side_effecting"
      ],
      "title": "OperationRecord",
      "type": "object"
    },
    "OperationStatus": {
      "enum": [
        "planned",
        "reserved",
        "started",
        "succeeded",
        "failed_known",
        "outcome_unknown",
        "cancelled_before_dispatch"
      ],
      "title": "OperationStatus",
      "type": "string"
    },
    "RunState": {
      "additionalProperties": false,
      "properties": {
        "applied_event_count": {
          "default": 0,
          "description": "Applied durable event count.",
          "minimum": 0,
          "title": "Applied Event Count",
          "type": "integer"
        },
        "brief_approved": {
          "description": "Verified brief approval reference state.",
          "title": "Brief Approved",
          "type": "boolean"
        },
        "brief_id": {
          "description": "Referenced B01 brief ID.",
          "title": "Brief Id",
          "type": "string"
        },
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "event_head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last durable event hash.",
          "title": "Event Head"
        },
        "run_id": {
          "description": "Program-generated deterministic run ID.",
          "title": "Run Id",
          "type": "string"
        },
        "runtime_version": {
          "default": "dr-runtime-v1",
          "description": "Runtime kernel version.",
          "title": "Runtime Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "default": "brief_pending",
          "description": "Explicit lifecycle status."
        },
        "task_id": {
          "description": "Referenced B01 task ID.",
          "title": "Task Id",
          "type": "string"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured terminal reason label.",
          "title": "Terminal Reason"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "brief_id",
        "brief_approved"
      ],
      "title": "RunState",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "brief_pending",
        "brief_approved",
        "researching",
        "validating",
        "complete",
        "insufficient_evidence",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "dr-contracts-v1",
          "default": "dr-contracts-v1",
          "description": "Stable DeepResearch contract version.",
          "title": "Contract Version",
          "type": "string"
        },
        "cost_micros": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cost Micros"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "dr-contracts-v1",
      "default": "dr-contracts-v1",
      "description": "Stable DeepResearch contract version.",
      "title": "Contract Version",
      "type": "string"
    },
    "journal": {
      "$ref": "#/$defs/OperationJournal"
    },
    "journal_hash": {
      "title": "Journal Hash",
      "type": "string"
    },
    "ledger": {
      "$ref": "#/$defs/BudgetLedger"
    },
    "ledger_hash": {
      "title": "Ledger Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_state": {
      "$ref": "#/$defs/RunState"
    },
    "run_state_hash": {
      "title": "Run State Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "dr-runtime-v2",
      "default": "dr-runtime-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "stream_head": {
      "title": "Stream Head",
      "type": "string"
    },
    "stream_sequence": {
      "minimum": 0,
      "title": "Stream Sequence",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "stream_sequence",
    "stream_head",
    "run_state",
    "run_state_hash",
    "ledger",
    "ledger_hash",
    "journal",
    "journal_hash"
  ],
  "title": "CoordinatedCheckpointV2",
  "type": "object"
}
